# MongoDB Cluster Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/CMLResult?retryWrites=true&w=majority
MONGODB_DB=CMLResult
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters

# Registration End Date (YYYY-MM-DD or ISO string)
# Public registrations will be closed after this date/time; admins can still add candidates.
REGISTRATION_END_DATE=2026-10-15T23:59:59
