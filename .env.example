# MongoDB Cluster Connection String
# Replace with your MongoDB Atlas connection string:
# e.g., mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/CMLResult?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/CMLResult

# Database Name (Specified by user)
MONGODB_DB=CMLResult

# Admin Access PIN / Password
ADMIN_PASSWORD=admin123
